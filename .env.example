# --- Gemini (image generation) ---
GEMINI_API_KEY=

# --- Appwrite Storage (hosts the generated try-on images) ---
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# --- Upload limits ---
MAX_FILE_SIZE_MB=10

# Max seconds to wait on Gemini before failing cleanly instead of hanging
# indefinitely. Must be comfortably LOWER than TRYON_SERVICE_TIMEOUT_MS on
# the Node backend (Backend-main/.env), or Node gives up first and you get
# an unhelpful ETIMEDOUT there instead of a clear error from here.
GEMINI_TIMEOUT_SECONDS=50

# Same reasoning, for the Appwrite upload step that runs after generation
# (see services/appwrite_service.py). Total worst case for one request is
# roughly GEMINI_TIMEOUT_SECONDS + APPWRITE_TIMEOUT_SECONDS — keep
# TRYON_SERVICE_TIMEOUT_MS on the Node backend comfortably above that sum.
APPWRITE_TIMEOUT_SECONDS=20
